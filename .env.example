# Afon configuration — copy to `.env` and fill in. All keys are prefixed AFON_.
# Never commit the real .env (see .gitignore).

# ---- Identity: make this YOUR assistant (no code/persona edits needed) ----------------
# The persona file is a template; these fill it in. Defaults are generic; personalise here.
AFON_ASSISTANT_NAME=Afon                 # what your assistant calls itself
AFON_USER_NAME=                            # your name (blank = it won't use a name)
AFON_USER_ADDRESS=                         # how it addresses you: "sir", "boss", your name, or blank
AFON_UNDERSTOOD_LANGUAGES=English          # comma-list it can UNDERSTAND (STT)
AFON_REPLY_LANGUAGE=English                # the single language it always REPLIES in
AFON_USER_TZ=UTC                           # your IANA timezone, e.g. Europe/Berlin, America/New_York
AFON_PERSONA_FILE=afon.md                # which file in personality/ holds the persona template

# ---- Provider selection ---------------------------------------------------------------
# Cloud-first for quality; if a cloud provider can't be built it AUTO-FALLS-BACK to the local
# engine (voice_local_fallback). Set AFON_STT_PROVIDER=whisper if you speak Armenian/Ukrainian.
AFON_STT_PROVIDER=deepgram          # deepgram (cloud, accurate) | whisper | moonshine (local)
AFON_TTS_PROVIDER=elevenlabs        # elevenlabs (the voice) | piper | kokoro (local, offline)
AFON_VOICE_LOCAL_FALLBACK=true      # cloud fails -> use local engine (so the pipeline always comes up)
AFON_TTS_FALLBACK_PROVIDER=piper    # local TTS used if the cloud TTS can't be built
AFON_STT_FALLBACK_PROVIDER=whisper  # local STT used if the cloud STT can't be built
AFON_LLM_BACKEND=freellmapi         # Afon's OWN brain: freellmapi | ollama | openai
AFON_OPENCLAW_DELEGATION_ENABLED=true   # let Afon CONSULT the OpenClaw fleet as a tool

# ---- ElevenLabs: the voice you want Afon to have ------------------------------------
AFON_ELEVENLABS_API_KEY=
AFON_ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency for streaming; eleven_turbo_v2_5 = a bit higher quality
AFON_ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Deepgram: accurate streaming speech recognition ("understands me really well") ---
AFON_DEEPGRAM_API_KEY=
AFON_DEEPGRAM_MODEL=nova-3
# Multilingual understanding. Afon ALWAYS replies in English; this only sets which spoken
# languages he can understand. 'multi' = Deepgram nova-3 code-switch across English/French/
# German/Russian (low latency). Deepgram does NOT support Armenian, and Ukrainian isn't in 'multi'
# — to understand ALL SIX (incl. Armenian + Ukrainian) set AFON_STT_PROVIDER=whisper (local
# faster-whisper, auto-detect; heavier on a no-GPU CPU but covers everything).
AFON_DEEPGRAM_LANGUAGE=multi

# ---- Audio routing (speakers <-> headphones / AirPods) --------------------------------
# Where Afon plays his voice. Alias ("speakers" | "headphones" | "airpods"), a device-name
# fragment, or a numeric index. Blank = OS default. A voice command ("switch to my headphones")
# saves a preference that overrides this at next start. Input stays on the laptop mic so
# Bluetooth keeps high-quality A2DP output (using AirPods as the mic forces low-quality HFP).
AFON_AUDIO_OUTPUT_DEVICE=
# Pin the mic by NAME substring (survives Bluetooth index shuffles), or by index.
AFON_AUDIO_INPUT_DEVICE_NAME=
AFON_AUDIO_INPUT_DEVICE_INDEX=

# ---- Smart barge-in (interrupt Afon mid-sentence by speaking) -----------------------
# 'auto' detects your live output device and turns barge-in ON only on a PRIVATE endpoint
# (headphones / AirPods / smart-glasses / phone-with-earbuds) and OFF on open speakers, so
# Afon never interrupts himself. 'on'/'off' force it.
AFON_BARGE_IN_MODE=auto
# Remote clients (Mentra glasses, iPhone, Android) declare how you're listening since the local
# device name can't tell: glasses | phone-headphones | android-headphones | phone-speaker |
# android | headphones | speakers. Blank on a local host (Windows/macOS/Linux laptop).
AFON_DEVICE_HINT=

# ---- Wake words -----------------------------------------------------------------------
AFON_WAKE_WORD_ENABLED=true
AFON_WAKE_WORD_ENGINE=openwakeword          # openwakeword (now) | porcupine (custom phrases)
AFON_WAKE_WORDS=afon,alfred,robbin,assist,time to work,wake up,six-one-nine
AFON_WAKE_WORD_THRESHOLD=0.5
AFON_PORCUPINE_ACCESS_KEY=                   # Picovoice key, for the custom-phrase engine

# ---- Brain / OpenClaw fleet -----------------------------------------------------------
# The brain WebSocket server (`python -m afon.brain.server`) hosts ONE shared AfonAgent so the
# laptop, iPhone (clients/iphone/) and Mentra glasses all reach the SAME brain + memory.
AFON_BRAIN_HOST=127.0.0.1            # set 0.0.0.0 to reach it from the phone/glasses (same Wi-Fi)
AFON_BRAIN_PORT=8765                 # WebSocket /voice port
AFON_CLIENT_HTTP_PORT=8766           # serves the iPhone web client at http://<host>:8766/iphone/
AFON_API_AUTH_TOKEN=                 # blank = loopback only; set a bearer secret when on 0.0.0.0
AFON_BRAIN_WS_URL=ws://127.0.0.1:8765/voice
AFON_OPENCLAW_GATEWAY_URL=http://127.0.0.1:8800
AFON_OPENCLAW_ROUTER_AGENT=ispir

# ---- freellmapi (direct-answer LLM) ---------------------------------------------------
AFON_FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
AFON_FREELLMAPI_API_KEY=

# ---- LLM latency tuning (see docs/AUDIT.md) -------------------------------------------
# A chain entry prefixed "groq:" hits Groq DIRECTLY (fast, consistent TTFT ~0.3s) using the key
# below — the best primary for a snappy voice turn. e.g. AFON_LLM_PRIMARY_MODEL=groq:llama-3.3-70b-versatile
AFON_GROQ_API_KEY=                     # https://console.groq.com -> API Keys (free tier available)
# If no FIRST token arrives within this many seconds, cancel + fail over to the next model.
AFON_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4.0
# Optional two-tier: a fast model tried FIRST (then the normal chain as quality fallback). Blank = off.
AFON_LLM_FAST_MODEL=                    # e.g. llama-3.1-8b-instant  (or groq:llama-3.1-8b-instant)

# ======================================================================================
# Phase 3 — knowledge & channel tools. Each is OPTIONAL: leave a block blank and Afon
# just says that capability "isn't configured yet" instead of crashing.
# ======================================================================================

# ---- Obsidian vault — REQUIRED (Afon's L3 memory; READS/SEARCHES the local mirror) --
# Keep this set: it's validated at startup and Afon warns loudly if it's missing/unreadable.
AFON_VAULT_PATH=C:\Users\iamva\Documents\Obsidian Vault
# Let Afon WRITE notes into the vault (write_vault tool). Keep FALSE on the laptop — there the
# vault is a one-way VPS->local sync target and local edits get clobbered. Set TRUE only on the
# host that OWNS the vault (the VPS), where writes are authoritative and safe.
AFON_VAULT_WRITABLE=false

# ---- Session hygiene: smart reset -----------------------------------------------------
# After this many idle minutes, the brain journals the prior conversation (L2) and clears WORKING
# memory, so a fresh conversation hours later doesn't drag stale context/anaphora. Durable memory
# (L1/L2/L3) is untouched. 0 disables.
AFON_SESSION_IDLE_RESET_MINUTES=180

# Speed vs polish (A/B). ON = a SHORT calendar/email/Notion-tasks/Telegram read is spoken verbatim,
# skipping the summary LLM pass (~1-3s faster on those turns). OFF (default) = the summary polishes a
# raw multi-item dump into a clean spoken sentence. Long results always summarise even when ON.
AFON_DIRECT_SPEAK_CHANNEL_READS=false

# ---- Phase 9: persistent memory (learned facts L1 + daily journal L2) ------------------
# Markdown under memory/learned and memory/journal — Afon remembers across restarts.
AFON_MEMORY_ENABLED=true
AFON_MEMORY_RECALL_LIMIT=5          # facts the recall tool returns
AFON_MEMORY_DIGEST_MAX=20           # recent learned facts injected into his system prompt
# L4 hot-cache (Phase 9b): blank = in-process cache only (still fast within a session). Point this
# at a Redis instance to share the cache across processes and survive a brain restart (24/7 win).
AFON_REDIS_URL=                     # e.g. redis://127.0.0.1:6379/0
# L5 semantic recall (Phase 9c): recall facts by meaning, not just keywords. Only active if a local
# embedder is installed — `uv sync` then `pip install sentence-transformers` (CPU model, ~90MB).
# Without it, recall stays keyword-only (graceful). No config needed beyond the toggle.
AFON_MEMORY_SEMANTIC_ENABLED=true

# ---- Phase 10: proactive engine (speak unprompted, clarify, confirm) -------------------
# OFF by default — he only volunteers things when you switch this on. A background tick weighs
# signals (routine, calendar, unread, self-health) and may speak/push within a daily budget and
# quiet hours. Modes (focus/lockdown) mute it on demand. See docs/EXPANSION-PLAN.md.
AFON_PROACTIVE_ENABLED=false
AFON_PROACTIVE_TICK_SECONDS=300
AFON_PROACTIVE_QUIET_HOURS=23:00-07:00     # no unprompted voice in this local-time window
AFON_PROACTIVE_DAILY_BUDGET=6              # max unprompted interjections per day
AFON_PROACTIVE_RELEVANCE_THRESHOLD=0.6     # only speak when a signal's urgency clears this
AFON_HOME_LOCATION=                        # default place for "weather" + the morning briefing

# ---- Web search (Tavily) --------------------------------------------------------------
AFON_TAVILY_API_KEY=                 # https://tavily.com -> API key

# ---- Page scrape (Jina Reader) --------------------------------------------------------
# Uses https://r.jina.ai — FREE + KEYLESS, nothing to configure. Optional key for higher limits:
AFON_JINA_API_KEY=                   # optional; get one free at https://jina.ai

# ---- Interactive headless browser (Browserbase; needs `uv sync --extra browse`) -------
AFON_BROWSERBASE_API_KEY=
AFON_BROWSERBASE_PROJECT_ID=

# ---- Telegram -------------------------------------------------------------------------
# Reading unread DMs needs a Telethon USER login (api id+hash from https://my.telegram.org,
# then a one-time interactive sign-in). Sending uses the bot token below.
AFON_TELEGRAM_API_ID=
AFON_TELEGRAM_API_HASH=
AFON_TELEGRAM_SESSION=afon
AFON_TELEGRAM_BOT_TOKEN=
AFON_TELEGRAM_DEFAULT_CHAT=          # default chat id for "send a telegram"
AFON_TELEGRAM_PHONE=                 # your number (+countrycode...) for the one-time login
AFON_GIPHY_API_KEY=                  # optional; "@gif <query>" search falls back to Giphy's public key
# Your personal music: a Telegram chat/group where you keep audio tracks. Afon finds a track
# and delivers it to your phone Telegram to tap & play. Use an id, @username, or the exact title.
AFON_TELEGRAM_PLAYLIST_CHAT=
AFON_TELEGRAM_MUSIC_TARGET=me        # where the chosen track is sent ('me' = Saved Messages → phone)

# ---- Music backend for "play X" -------------------------------------------------------
# ytmusic = YouTube Music (free, music-tuned, no account) |
# telegram = your personal Telegram playlist | youtube = plain YouTube search.
AFON_MUSIC_SOURCE=ytmusic

# ---- Phase 11: Gmail + Google Calendar (one OAuth app) --------------------------------
# To use Gmail "through an app": a real Google Cloud OAuth app. Do the one-time
# consent once (uv run python bench/google_login.py) — see that file's header for the console steps
# (enable Gmail API + Calendar API, create a Web OAuth client, add the redirect below) — then paste
# the printed refresh token here. The same app/token covers Gmail (read/draft/send) AND Calendar.
# send_email + create_event are confirm-gated. Everything degrades until these are set.
AFON_GOOGLE_CLIENT_ID=
AFON_GOOGLE_CLIENT_SECRET=
AFON_GOOGLE_REFRESH_TOKEN=
AFON_GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8585/oauth2callback   # must match the Google app

# ---- Phase 11: Home Assistant (local-first smart home) --------------------------------
# Create a long-lived access token in HA (your profile -> Security -> Long-lived access tokens) and
# point AFON_HA_URL at your instance. Afon reads states ("is the door locked?") and calls
# services (lights/scenes/climate/locks); locks/alarms/covers are confirmed first. Degrades if unset.
AFON_HA_URL=                        # e.g. http://homeassistant.local:8123
AFON_HA_TOKEN=

# ---- Phase 11: Notion (read / write / comment) ----------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations, copy its secret, then
# SHARE each page/database you want Afon to touch with that integration (••• → Connections →
# your integration). Notion is deny-by-default: he only ever sees what you share. Writes/comments
# are confirm-gated. Degrades until set.
AFON_NOTION_TOKEN=                  # 'ntn_...' or 'secret_...' integration token
AFON_NOTION_VERSION=2022-06-28
AFON_NOTION_TASKS_DB_ID=            # tasks dashboard DB id (32-hex from its URL); share it with the integration

# Autonomous daily BACKLOG pass (Phase 3.1) — opt-in. When on AND a tasks DB is set, a daily job has the
# bounded worker attempt overdue/undated Notion tasks (safe research/draft only; outward steps deferred)
# and comments the result onto each task. OFF by default (it acts unattended).
AFON_BACKLOG_ENABLED=false
AFON_BACKLOG_TIME=09:30            # HH:MM, your timezone
AFON_BACKLOG_MAX_TASKS=2          # tasks attempted per daily pass

# ---- External tools via MCP (Model Context Protocol) ----------------------------------
# Afon speaks MCP over stdio, so ANY MCP server's tools appear in his registry (namespaced
# mcp__<server>__<tool>). JSON map of name -> {command, args, env}; inline JSON or a path to a .json
# file. Only servers listed here are launched (no default, no arbitrary access); missing -> zero tools.
#
# Composio (250+ OAuth-managed app integrations — Slack, GitHub, Google Drive, Linear, …) is the
# recommended way to add breadth: in the Composio dashboard create an MCP server, connect your app
# accounts there, then paste its URL below (bridged to stdio via mcp-remote). Preferred over Composio's
# agent-SDK path — no new dependency, no parallel agent loop; the tools join Afon's own voice-tuned
# loop and his confirm-gate still applies to outward actions. Example (single line):
# AFON_MCP_SERVERS={"composio":{"command":"npx","args":["-y","mcp-remote","https://mcp.composio.dev/<your-server-id>"]}}
AFON_MCP_SERVERS=

# ---- System control (files / processes / PowerShell) ----------------------------------
AFON_SYSTEM_TOOLS_ENABLED=true
# Paths under these roots are refused for deletion (catastrophe guard).
AFON_SYSTEM_PROTECTED_PATHS=C:\Windows,C:\Program Files,C:\Program Files (x86)

# ---- Phase 13: coding & self-improvement (Git + GitHub) -------------------------------
# Afon can read/edit his own source, run the suite, lint, and make REVERSIBLE git commits (never
# force-push/reset — a revert is always a new commit). Secrets are hard-blocked from read/write.
# Commits + pushes are confirm-gated. To let him push: create a GitHub repo + a fine-grained PAT
# (Contents: read/write on that repo), then `git remote add origin https://<PAT>@github.com/<you>/<repo>.git`
# — see TODO-NOW.md Phase 13 for the exact steps. He commits locally (fully reversible) even with no remote.
AFON_CODING_TOOLS_ENABLED=true
AFON_SKILLS_ENABLED=true
AFON_GIT_AUTHOR_NAME=Afon
AFON_GIT_AUTHOR_EMAIL=afon@vazghen.local
# One-step "open a GitHub issue" (create_github_issue tool) — a fine-grained PAT with Issues:
# read/write on the repo below. Lets Afon file an issue in a single tool call instead of the 2-step
# Composio router. Blank = the tool says it's not configured. (The PAT above under Phase 13 self-
# improvement is for PUSH; this one only needs Issues scope — you can reuse the same PAT if it has both.)
AFON_GITHUB_TOKEN=
AFON_GITHUB_REPO=                    # e.g. you/your-repo

# ---- Production: arm the OpenClaw fleet consult (off by default) -----------------------
# The fleet touches shared VPS infra, so Afon only CONSULTS it (via ispir) when armed. Leave false
# for testing; set true for a 24/7 deployment where you want him to reach the team without asking.
AFON_FLEET_AUTHORIZED=false

# ---- Local visible browser (needs: uv sync --extra browse ; playwright install chromium)
AFON_BROWSER_TOOLS_ENABLED=true
AFON_BROWSER_HEADLESS=false                  # false = you can watch + finish logins
AFON_BROWSER_PROFILE_DIR=                    # blank = <repo>/.afon-browser (stays logged in)

# ---- Protocols (password-gated routines — CHANGE THESE) -------------------------------
AFON_PROTOCOLS_ENABLED=true
# All protocol passwords are 4 random digits — generate via 'scripts/rotate_protocols.sh' or
# the setup wizard ("regenerate protocol passwords") after first deploy. Each password is a
# separate 0000-9999 value; the runner uses constant-time compare.
AFON_PROTOCOL_GOODNIGHT_PASSWORD=0000        # 'goodnight'  -> stops Afon
AFON_PROTOCOL_PHOENIX_PASSWORD=0000          # 'phoenix'    -> restarts Afon
AFON_PROTOCOL_RAGNAROK_PASSWORD=0000        # 'ragnarok'   -> restarts the laptop
AFON_PROTOCOL_BACKUP_PASSWORD=0000          # 'backup'     -> archives Afon memory
AFON_PROTOCOL_PING_PASSWORD=0000            # 'ping'       -> sends a phone push test
AFON_PROTOCOL_DIAGNOSTICS_PASSWORD=0000      # 'diagnostics' -> writes a local health report
AFON_PROTOCOL_AUDITPACK_PASSWORD=0000       # 'auditpack'  -> archives audit logs
AFON_PROTOCOL_CHECKPOINT_PASSWORD=0000       # 'checkpoint' -> archives non-secret context

# ---- Phase 4: proactivity & push ------------------------------------------------------
AFON_SCHEDULER_DB_PATH=                       # blank = <repo>/afon_jobs.sqlite
AFON_NTFY_TOPIC=                              # ntfy.sh topic for phone push (pick a unique one)
AFON_NTFY_SERVER=https://ntfy.sh
# Phase 4b true-24/7: one-shot/at reminders push even with the PC off (ntfy holds them server-side).
# Recurring (daily) reminders need the always-on VPS ticker — see deploy/vps/. Once deployed, set:
AFON_TICKER_URL=                              # e.g. http://127.0.0.1:8770 (reach VPS via tunnel)
AFON_TICKER_TOKEN=                            # optional bearer secret, must match the ticker

# ---- Phase 5: speaker biometrics (respond only to the enrolled owner's voice) ---------
AFON_SPEAKER_ID_ENABLED=false                 # true after enrolling (uv sync --extra identity; bench/enroll_voice.py)
AFON_SPEAKER_PROFILE_PATH=                    # blank = <repo>/voiceprint.json
AFON_SPEAKER_THRESHOLD=0.25                   # ECAPA cosine accept threshold (raise = stricter)

# ---- Phase 6: multi-device routing ----------------------------------------------------
# Auto-route output to AirPods/headphones when connected to this laptop (barge-in then auto-on).
AFON_AUTO_ROUTE_HEADPHONES=true
# Remote clients (iPhone/Mentra) declare their device via the Hello frame; locally AFON_DEVICE_HINT
# (above) can force a kind. Set AFON_AUDIO_OUTPUT_DEVICE=auto to always prefer headphones.
