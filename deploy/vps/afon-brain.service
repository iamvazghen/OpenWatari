[Unit]
Description=Afon brain - always-on agent + WebSocket voice endpoint + reminder scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to match your VPS layout. Rewritten by deploy/vps/install-brain.sh.
User=openclaw
WorkingDirectory=/home/openclaw/afon
EnvironmentFile=/home/openclaw/afon/.env
# uv runs the brain from the synced project venv (brain + channels extras).
ExecStart=/home/openclaw/.local/bin/uv run --no-sync python -m afon.brain.server
Restart=always
RestartSec=5
# Bounded so a leak can't take the box down; systemd restarts it instead.
MemoryMax=1500M
OOMScoreAdjust=200
# Survive transient flaps without disabling the unit.
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
